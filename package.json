{
  "name": "@patroltech/sdk-api",
  "version": "1.0.0",
  "description": "Official TypeScript SDK for the PatrolTech public REST API, generated from its OpenAPI contract",
  "license": "MIT",
  "author": "Ingenieros Web SL <info@patroltech.app>",
  "homepage": "https://github.com/PatrolTech/sdk-api#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PatrolTech/sdk-api.git"
  },
  "bugs": {
    "url": "https://github.com/PatrolTech/sdk-api/issues"
  },
  "keywords": [
    "patroltech",
    "guard-tour",
    "security-patrol",
    "openapi",
    "sdk",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "node": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      },
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "generate": "orval --config orval.config.ts && node scripts/encode-path-params.mjs",
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && npm run generate && npm run build:esm && npm run build:cjs",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json && node -e \"require('node:fs').writeFileSync('dist/cjs/package.json', JSON.stringify({ type: 'commonjs' }))\"",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "examples:check": "tsc -p tsconfig.examples.json",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "orval": "8.8.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "overrides": {
    "js-yaml": "4.3.2"
  }
}
